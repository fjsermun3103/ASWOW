# Copia este archivo como .env y ajusta los valores.
# Base de datos local (docker-compose.yml). En producción: cadena "pooled" de Neon.
DATABASE_URL="postgresql://aswow:aswow@localhost:5433/aswow?schema=public"
# Puerto local de la API. En Render no se define: allí se usa la variable PORT que pone Render.
API_PORT=3001
# Orígenes permitidos para CORS (separados por comas). Con el proxy de mismo origen casi no se usa.
CORS_ORIGIN="http://localhost:5173"
# true en producción (HTTPS): la cookie de sesión solo viaja cifrada.
COOKIE_SECURE=false
